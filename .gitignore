# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment & secrets – NEVER commit these
.env
.env.*
*.secret

# SQLite database (contains real user data)
user_database/
*.db
*.sqlite3

# Uploaded / sanitized files (can be large and contain malware samples)
outputs/sanitized/*
outputs/reports/*
outputs/plots/*
uploads/
tmp/

# Data
data/raw/*
data/processed/*
data/samples/*
!data/raw/benign/
!data/raw/malicious/
!data/samples/benign/
!data/samples/suspicious/

# Trained models
models/trained/*
!models/trained/.gitkeep

# Ollama / LLM artefacts
*.modelfile
*.gguf

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
