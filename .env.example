# =============================================================
#  PHAROS – Environment Variable Template
#  Copy this file to .env and fill in real values.
#  This file IS safe to commit – it contains no real secrets.
# =============================================================

# ── Flask ─────────────────────────────────────────────────────
# Local:      development
# Production: production
FLASK_ENV=development
FLASK_DEBUG=0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHAROS_SECRET_KEY=replace-with-a-long-random-string

# ── Database ──────────────────────────────────────────────────
# Local:      leave blank (uses local SQLite user_database/pharos_users.db)
# Vercel:     set Turso credentials for persistent cloud SQLite:
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# Production (Render): /data (if using Render Persistent Disk)
# PHAROS_DB_PATH=

# ── LLM – Local (Ollama) ──────────────────────────────────────
# Only used locally when GEMINI_API_KEY is not set.
OLLAMA_MODEL=pharos-llm
OLLAMA_HOST=http://localhost:11434

# ── LLM – Cloud (Gemini API) ─────────────────────────────────
# Required on Render (Ollama cannot run on cloud hosting).
# Get a free key at: https://aistudio.google.com
# GEMINI_API_KEY=your-gemini-api-key-here

# ── File Upload ───────────────────────────────────────────────
MAX_CONTENT_LENGTH=52428800
