# .env.example – copy this to .env and fill in your own values.
# NEVER commit the actual .env file.

# Flask secret key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHAROS_SECRET_KEY=replace-with-a-long-random-string

# Optional: set to "production" or "development"
FLASK_ENV=production

# Database path override (leave blank to use default user_database/pharos_users.db)
# PHAROS_DB_PATH=

# Max upload size in bytes (default 50 MB)
# MAX_CONTENT_LENGTH=52428800
